{
  "name": "banki-shop",
  "version": "0.1.0",
  "private": true,
  "description": "Адаптивная страница интернет-магазина Banki.shop",
  "engines": {
    "node": "16.x"
  },
  "scripts": {
    "serve": "webpack serve --mode development",
    "build": "webpack --mode production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,vue}\" webpack.config.js eslint.config.mjs",
    "lint:fix": "eslint \"src/**/*.{ts,vue}\" webpack.config.js eslint.config.mjs --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "stylelint": "stylelint \"src/**/*.{css,scss,vue}\"",
    "stylelint:fix": "stylelint \"src/**/*.{css,scss,vue}\" --fix"
  },
  "dependencies": {
    "pinia": "2.3.1",
    "swiper": "5.4.5",
    "vue": "2.7.16",
    "vue-awesome-swiper": "4.1.1"
  },
  "devDependencies": {
    "@types/webpack-env": "1.18.8",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "css-loader": "6.11.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^13.24.0",
    "html-webpack-plugin": "5.6.3",
    "postcss-html": "1.7.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.3.3",
    "sass": "1.77.8",
    "sass-loader": "13.3.3",
    "style-loader": "3.3.4",
    "stylelint": "^15.11.0",
    "stylelint-config-html": "1.1.0",
    "stylelint-config-recommended": "13.0.0",
    "stylelint-config-recommended-vue": "^1.6.0",
    "stylelint-config-standard": "^34.0.0",
    "stylelint-config-standard-scss": "^11.1.0",
    "stylelint-order": "^6.0.4",
    "stylelint-scss": "^5.3.1",
    "ts-loader": "9.5.1",
    "typescript": "4.9.5",
    "vue-eslint-parser": "^9.4.3",
    "vue-loader": "15.11.1",
    "vue-template-compiler": "2.7.16",
    "webpack": "5.94.0",
    "webpack-cli": "4.10.0",
    "webpack-dev-server": "4.15.2"
  }
}
